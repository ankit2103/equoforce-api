PORT=3000

# Google SMTP Configuration
# Use your Gmail address
SMTP_USER=your_email@gmail.com

# Use an App Password (NOT your Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on your Google account
SMTP_PASS=your_app_password_here

# Default sender name
SMTP_FROM_NAME=Equoforce

# CORS — set to specific origin(s) in production, e.g. https://yourdomain.com
# Leave blank or set to * to allow all origins
CORS_ORIGIN=*
