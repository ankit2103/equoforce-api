UNSUBSCRIBE_SPREADSHEET_ID=

# Full Google service account JSON key, minified to a single line
# (Google Cloud Console -> IAM & Admin -> Service Accounts -> Keys -> Add Key -> JSON)
GOOGLE_CREDENTIALS_JSON=